        text-align: center;
        box-shadow: none;
        box-sizing: border-box;
    }
    .homepage-hero::before {
        content: "";
        position: absolute;
        left: 50%;
        top: -48px;
        width: min(540px, 88%);
        height: 210px;
        transform: translateX(-50%);
        pointer-events: none;
        background: radial-gradient(circle, rgba(255, 102, 81, 0.18) 0%, rgba(234, 127, 185, 0.1) 34%, transparent 72%);
        filter: blur(12px);
        opacity: 0.85;
    }
    .homepage-hero::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 164px;
        height: 1px;
        transform: translateX(-50%);
        background: linear-gradient(90deg, transparent, rgba(255, 102, 81, 0.5), transparent);
        opacity: 0.9;
        pointer-events: none;
    }
    .homepage-hero__eyebrow {
        position: relative;
        z-index: 1;
        margin: 0 0 14px;
        color: var(--color-brand-accent, #ff8a75);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
