# ---------- Database ----------
# DATABASE_URL 把密码内嵌:mysql2 跟 @ch/db 里都解析它。
# docker-compose 同时读 MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD 初始化容器,
# 三者**必须一致**, 否则容器起来后业务进程登不进去。
DATABASE_URL=mysql://ch:CHANGE_ME_MYSQL_PASSWORD@localhost:3306/ch
MYSQL_USER=ch
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=ch

# ---------- Redis (BullMQ + SSR cache) ----------
# 本地 dev 不开 AUTH: REDIS_URL=redis://localhost:6379
# 生产开 AUTH: 在 REDIS_URL 里塞密码,docker-compose 同时读 REDIS_PASSWORD
# 启动 redis-server --requirepass。两个变量必须一致,否则连接会被 NOAUTH。
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- Object Storage (MinIO / S3) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ch-media

# ---------- LLM provider ----------
# Default: Groq (fast, cheap, no server-side prompt cache — every call billed
# at full token rate). Switch to Anthropic to get ~90 % savings on system-prompt
# tokens via cache_control headers (SystemBlock.cache=true). To switch:
#   1. pnpm --filter @ch/agents add @anthropic-ai/sdk
#   2. Set LLM_PROVIDER=anthropic
#   3. Set ANTHROPIC_API_KEY
#
# LLM_PROVIDER=groq   # or: anthropic
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL_LARGE=llama-3.3-70b-versatile
GROQ_MODEL_MEDIUM=llama-3.3-70b-versatile
GROQ_MODEL_SMALL=llama-3.1-8b-instant
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# ANTHROPIC_MODEL_OPUS=claude-opus-4-7
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ---------- App ----------
API_PORT=4000
WEB_PORT=3000
LOG_LEVEL=info

# ---------- Admin auth ----------
# ADMIN_TOKEN: bearer token the API checks on every /admin/* request.
# API_ADMIN_TOKEN: same value, read by the Next.js server-side proxy.
# ADMIN_PASSWORD: HTTP Basic Auth password for the /admin web UI.
# ADMIN_USER: HTTP Basic Auth username (default: admin).
# Leave all unset for local dev (auth is skipped with a warning).
ADMIN_TOKEN=REPLACE_ME_RANDOM_TOKEN
API_ADMIN_TOKEN=REPLACE_ME_RANDOM_TOKEN
ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
# ADMIN_USER=admin

# ---------- Site ----------
SITE_URL=https://your-domain.com
SITE_NAME=内容中台
WEB_URL=http://localhost:3000
# API_URL is the Fastify origin used by the Next.js proxy (server-side only).
# In production point this at the internal Fastify address.
API_URL=http://localhost:4000
REVALIDATE_SECRET=REPLACE_ME_RANDOM_SECRET

# ---------- Monitoring (Day 7) ----------
SENTRY_DSN=https://xxx@sentry.io/yyy
ALERT_QUEUE_THRESHOLD=100
ALERT_LLM_FAIL_RATE=0.15
ALERT_INTERVAL_MINUTES=5
ANALYTICS_CRON=0 2 * * *
